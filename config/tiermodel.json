      "templateAccount": "adm-{TOKENLC}-dns-template",
      "description": "DNS administration for {TIER}. Holds its permissions through DnsAdmins, which stays empty of direct members.",
      "nestIntoForeignDenyGroups": true,
      "siloMember": true,
      "privilegedGroupNesting": [
        {
          "name": "DnsAdmins"
        }
      ],
      "delegations": [
        {
          "targetOu": "$MicrosoftDns",
          "rights": "CreateChild, DeleteChild",
