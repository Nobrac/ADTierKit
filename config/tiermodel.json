    },
    {
      "name": "GPO-Link",
      "enabled": true,
      "tiers": [
        1,
        2
      ],
      "roleGroup": "G-{TOKEN}-GPO-Admins",
      "templateAccount": "adm-{TOKENLC}-gpo-template",
      "description": "Links and unlinks Group Policy objects within the {TIER} branch, and edits the policies delegated to {TIER}. Cannot create policies and cannot block inheritance.",
      "nestIntoForeignDenyGroups": true,
      "siloMember": true,
      "delegations": [
        {
          "targetOu": "",
          "rights": "ReadProperty, WriteProperty",
          "objectType": "gPLink",
          "inheritedObjectType": "organizationalUnit",
          "inheritance": "All",
          "type": "Allow",
          "comment": "Link and unlink policies on the OUs of this tier. gPOptions is deliberately excluded: the GPMC 'Link GPOs' permission writes both attributes, and write access to gPOptions lets the delegate block inheritance and cancel out the baseline handed down from the domain."
