{
  "schemaVersion": "1.0",
  "metadata": {
    "name": "Default Enterprise Access / Tier Model",
    "description": "Three-tier administrative model (Tier 0 control plane, Tier 1 server plane, Tier 2 workstation plane) including OU structure, AGDLP groups, ACL delegation, logon-restriction GPOs and Kerberos Authentication Policy Silos.",
    "revision": 1
  },
  "domain": {
    "fqdn": null,
    "rootOu": "Tiering",
    "rootOuDescription": "Root of the administrative tier model - managed by ADTierKit. Do not edit manually."
  },
  "options": {
    "protectOusFromAccidentalDeletion": true,
    "blockInheritanceOnTierRoots": false,
    "blockGpoInheritanceOnTierRoots": true,
    "createAdminAccounts": true,
    "adminAccountsDisabledOnCreation": true,
    "adminAccountsSensitiveNoDelegation": true,
    "addTier0AdminsToProtectedUsers": true,
    "enableAdRecycleBin": true,
    "machineAccountQuota": 0,
    "redirectComputersTo": "Tier-2/Staging",
    "redirectUsersTo": null,
    "enableSiteLinkNotification": true,
    "deployWindowsLaps": true,
    "createKdsRootKey": true,
    "kdsRootKeyEffectiveImmediately": false,
    "createGpos": true,
    "restrictedGroupsMode": "MemberOf",
    "linkGpos": true,
    "enforceGpoLinks": true,
    "createAuthenticationPolicySilo": true,
    "authenticationPolicyEnforcement": "Audit",
    "tier0TgtLifetimeMinutes": 240
  },
  "tiers": [
    {
      "id": 0,
      "name": "Tier-0",
      "description": "Control plane: domain controllers, AD, PKI, identity and directory synchronisation infrastructure.",
      "organizationalUnits": [
        {
          "name": "Accounts",
          "description": "Tier 0 administrative user accounts"
        },
        {
          "name": "Groups",
          "description": "Tier 0 role and access groups"
        },
        {
          "name": "Servers",
          "description": "Tier 0 servers (PKI, ADFS, Entra Connect, backup of DCs). Domain controllers stay in OU=Domain Controllers."
        },
        {
          "name": "Devices",
          "description": "Privileged Access Workstations (PAW) used to administer Tier 0"
        },
        {
          "name": "Service-Accounts",
          "description": "Tier 0 service accounts, gMSA and dMSA"
        },
        {
          "name": "Staging",
          "description": "Landing zone for newly joined Tier 0 systems before classification"
        }
      ],
      "groups": [
        {
          "name": "G-T0-Admins",
          "scope": "Global",
          "targetOu": "Groups",
          "description": "Tier 0 administrators (role group). Members administer the control plane."
        },
        {
          "name": "G-T0-Operators",
          "scope": "Global",
          "targetOu": "Groups",
          "description": "Tier 0 operators without directory write permissions."
        },
        {
          "name": "DL-T0-LocalAdmins",
          "scope": "DomainLocal",
          "targetOu": "Groups",
          "description": "Nested into the local Administrators group of Tier 0 systems.",
          "members": [
            "G-T0-Admins"
          ]
        },
        {
          "name": "DL-T0-RemoteDesktop",
          "scope": "DomainLocal",
          "targetOu": "Groups",
          "description": "Nested into the local Remote Desktop Users group of Tier 0 systems.",
          "members": [
            "G-T0-Admins"
          ]
        },
        {
          "name": "DL-T0-DenyLogon",
          "scope": "DomainLocal",
          "targetOu": "Groups",
          "description": "Principals that must never authenticate to a Tier 0 system.",
          "members": [
            "G-T1-Admins",
            "G-T1-Operators",
            "G-T2-Admins",
            "G-T2-Operators"
          ]
        }
      ],
      "adminAccounts": [
        {
          "samAccountName": "adm-t0-breakglass",
          "displayName": "Tier 0 Break Glass Account",
          "targetOu": "Accounts",
          "memberOf": [
            "G-T0-Admins"
          ],
          "description": "Emergency access account. Keep credential in a sealed envelope, monitor every use.",
          "excludeFromSilo": true
        },
        {
          "samAccountName": "adm-t0-template",
          "displayName": "Tier 0 Admin Template",
          "targetOu": "Accounts",
          "memberOf": [
            "G-T0-Admins"
          ],
          "description": "Template account - copy this object when onboarding a Tier 0 administrator."
        }
      ],
      "delegations": [
        {
          "principal": "G-T0-Admins",
