        },
        {
          "targetOu": "$DomainDnsZones",
          "rights": "CreateChild, DeleteChild",
          "objectType": "dnsZone",
          "inheritedObjectType": null,
          "inheritance": "All",
          "type": "Allow",
          "comment": "The same right in the domain DNS application partition, where zones created since Windows Server 2003 actually live."
        },
        {
          "targetOu": "$DomainDnsZones",
          "rights": "ReadProperty, WriteProperty, Delete, DeleteTree",
          "objectType": null,
          "inheritedObjectType": null,
          "inheritance": "Descendents",
          "type": "Allow",
          "comment": "Manage the zones and records below the partition. WriteDacl and WriteOwner are deliberately absent, as everywhere else in this model."
        }
      ]
    },
    {
      "name": "DNS-Records",
      "enabled": false,
      "tiers": [
        1
      ],
      "roleGroup": "G-{TOKEN}-DNS-Operators",
      "templateAccount": "adm-{TOKENLC}-dnsrec-template",
