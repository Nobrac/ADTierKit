        {
          "targetOu": "",
          "rights": "ReadProperty",
          "objectType": "gPOptions",
          "inheritedObjectType": "organizationalUnit",
          "inheritance": "All",
          "type": "Allow",
          "comment": "Read only, so the GPMC can display the inheritance state it is not allowed to change."
        }
      ]
    }
