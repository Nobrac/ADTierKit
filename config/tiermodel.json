      "gpos": [
        {
          "name": "T0-Logon-Restrictions",
          "targetOu": "",
          "linkEnabled": true,
          "comment": "Blocks Tier 1 and Tier 2 principals from authenticating to Tier 0 systems.",
          "userRights": {
            "SeDenyInteractiveLogonRight": [
              "DL-T0-DenyLogon"
            ],
            "SeDenyRemoteInteractiveLogonRight": [
              "DL-T0-DenyLogon"
            ],
            "SeDenyNetworkLogonRight": [
              "S-1-5-113",
              "S-1-5-32-546"
            ],
            "SeDenyBatchLogonRight": [
              "DL-T0-DenyLogon"
            ],
            "SeDenyServiceLogonRight": [
              "DL-T0-DenyLogon"
            ]
          },
          "allowedUserRights": null,
          "restrictedGroups": {
            "S-1-5-32-544": [
              "DL-T0-LocalAdmins"
            ],
            "S-1-5-32-555": [
              "DL-T0-RemoteDesktop"
            ]
          },
          "registrySettings": [
            {
              "key": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System",
              "valueName": "LocalAccountTokenFilterPolicy",
              "type": "DWord",
              "value": 0,
              "comment": "Keep UAC remote restrictions for local accounts"
            },
            {
              "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\NetworkProvider\\HardenedPaths",
              "valueName": "\\\\*\\SYSVOL",
              "type": "String",
              "value": "RequireMutualAuthentication=1, RequireIntegrity=1",
              "comment": "UNC hardened path for policy retrieval"
            },
            {
              "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\NetworkProvider\\HardenedPaths",
              "valueName": "\\\\*\\NETLOGON",
              "type": "String",
              "value": "RequireMutualAuthentication=1, RequireIntegrity=1",
              "comment": "UNC hardened path for logon script retrieval"
            },
            {
              "key": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa",
              "valueName": "RunAsPPL",
              "type": "DWord",
              "value": 1,
              "comment": "LSA protected process"
            }
          ],
          "exceptionGroup": "DL-T0-Exempt-Logon",
          "exceptionGroupOu": "Groups"
        },
        {
          "name": "T0-DomainController-Baseline",
          "targetOu": "$DomainControllers",
          "linkEnabled": true,
          "comment": "Applies the Tier 0 logon restrictions to the Domain Controllers OU.",
          "userRights": {
            "SeDenyInteractiveLogonRight": [
              "DL-T0-DenyLogon"
            ],
            "SeDenyRemoteInteractiveLogonRight": [
              "DL-T0-DenyLogon"
            ],
            "SeDenyNetworkLogonRight": [
              "S-1-5-113",
              "S-1-5-32-546"
            ],
            "SeDenyBatchLogonRight": [
              "DL-T0-DenyLogon"
            ],
            "SeDenyServiceLogonRight": [
              "DL-T0-DenyLogon"
            ]
          },
          "restrictedGroups": {},
          "registrySettings": [],
          "allowedUserRights": {
            "SeInteractiveLogonRight": [
              "S-1-5-32-544",
              "G-T0-Admins"
            ],
            "SeRemoteInteractiveLogonRight": [
              "S-1-5-32-544",
              "G-T0-Admins"
            ]
          }
        }
      ]
