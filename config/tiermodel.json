      "siloMember": true,
      "delegations": [
        {
          "targetOu": "$DnsZone:apps.example.com",
          "rights": "CreateChild, DeleteChild",
          "objectType": "dnsNode",
          "inheritedObjectType": null,
          "inheritance": "All",
          "type": "Allow",
          "comment": "Create and delete records in this zone only. Change the zone name before enabling this role."
        },
        {
          "targetOu": "$DnsZone:apps.example.com",
          "rights": "ReadProperty, WriteProperty",
          "objectType": null,
          "inheritedObjectType": "dnsNode",
          "inheritance": "Descendents",
          "type": "Allow",
          "comment": "Update existing records in this zone."
        }
      ]
    },
    {
      "name": "GPO",
      "enabled": true,
      "tiers": [
        0
      ],
      "roleGroup": "G-{TOKEN}-GPO-Admins",
      "templateAccount": "adm-{TOKENLC}-gpo-template",
      "description": "Group Policy creation for the whole domain. Creating a policy is a Tier 0 operation because the creator becomes its owner.",
      "nestIntoForeignDenyGroups": true,
      "siloMember": true,
      "privilegedGroupNesting": [
        {
          "sid": "520"
        }
      ],
      "delegations": [
        {
          "targetOu": "$PoliciesContainer",
          "rights": "CreateChild",
          "objectType": "groupPolicyContainer",
          "inheritedObjectType": null,
          "inheritance": "All",
          "type": "Allow",
          "comment": "Create policy objects in the directory. The matching SYSVOL folder rights come from Group Policy Creator Owners, which is why the role is nested into it rather than granted the folder ACL directly."
        },
        {
          "targetOu": "$DomainRoot",
          "rights": "ReadProperty, WriteProperty",
          "objectType": "gPLink",
          "inheritedObjectType": null,
          "inheritance": "None",
          "type": "Allow",
          "comment": "Link policies at the domain head - a Tier 0 operation. Deliberately without gPOptions."
        }
