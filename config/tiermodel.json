          "objectType": null,
          "inheritedObjectType": null,
          "inheritance": "Descendents",
          "type": "Allow",
          "comment": "Manage every object below the Tier-0 branch - permissions on the branch itself stay out of reach"
        },
        {
          "principal": "G-T0-Operators",
          "targetOu": "Servers",
          "rights": "CreateChild, DeleteChild",
          "objectType": "computer",
          "inheritance": "All",
          "type": "Allow",
          "comment": "Create and delete Tier-0 computer objects",
          "inheritedObjectType": null
        },
        {
          "principal": "G-T0-Operators",
          "targetOu": "Servers",
          "rights": "ExtendedRight",
          "objectType": "User-Force-Change-Password",
          "inheritedObjectType": "computer",
          "inheritance": "Descendents",
          "type": "Allow",
          "comment": "Reset the computer account password - required to join or rejoin"
        },
        {
          "principal": "G-T0-Operators",
          "targetOu": "Servers",
          "rights": "Self",
          "objectType": "Validated-DNS-Host-Name",
          "inheritedObjectType": "computer",
          "inheritance": "Descendents",
          "type": "Allow",
          "comment": "Validated write of the DNS host name"
        },
        {
          "principal": "G-T0-Operators",
          "targetOu": "Servers",
          "rights": "Self",
          "objectType": "Validated-SPN",
          "inheritedObjectType": "computer",
          "inheritance": "Descendents",
          "type": "Allow",
          "comment": "Validated write of the service principal names"
        },
        {
          "principal": "G-T0-Operators",
          "targetOu": "Servers",
          "rights": "ReadProperty, WriteProperty",
          "objectType": "Account-Restrictions",
          "inheritedObjectType": "computer",
          "inheritance": "Descendents",
          "type": "Allow",
          "comment": "Account restrictions property set - required to enable the joined account"
        },
        {
          "principal": "G-T0-Operators",
