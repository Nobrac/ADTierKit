# Run artefacts - never belong in the repository
Logs/
Reports/
Credentials/

# Backups the tool writes next to the originals
*.bak-*
config/*.bak-*

# Configuration backups written by Update-TierConfiguration.ps1
config/*.bak
config/tiermodel.json.*.bak

# Editor and OS noise
.vscode/
.idea/
Thumbs.db
desktop.ini

# .NET build output of the GUI
gui/**/bin/
gui/**/obj/
gui/**/TestResults/
gui/publish/
.vs/
*.user
